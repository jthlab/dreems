rule write_prepared_manifest:
    input:
        prepared_manifest_inputs,
    output:
        manifest=prepared_manifest_path("{split}"),
    run:
        from pathlib import Path

        split = str(wildcards.split)
        manifest_paths = [
            str(Path(prepared_path(split, chunk)).resolve())
            for chunk in split_chunks(split)
        ]
        path = Path(output.manifest)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(manifest_paths) + "\n")


rule production_tranche:
    input:
        production_tranche_inputs,
    output:
        done=tranche_done_path("{split}", "{tranche}"),
    run:
        from pathlib import Path

        path = Path(output.done)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(str(item) for item in input) + "\n")


