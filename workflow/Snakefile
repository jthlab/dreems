            --output {output.stats:q}
        """


rule write_normalization_manifest:
    input:
        normalization_manifest_inputs,
    output:
        manifest=normalization_manifest_path(),
    run:
        from pathlib import Path

        manifest_paths = [
            str(Path(normalization_group_path(group)).resolve())
            for group in NORMALIZATION_GROUPS
        ]
        path = Path(output.manifest)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(manifest_paths) + "\n")


rule write_training_input_manifest:
