CARTOPY_ARCHIVE = f"{CARTOPY_DATA_DIR}/downloads/{CARTOPY_LAND_STEM}.zip"
CARTOPY_ARCHIVE_URL = (
    f"https://naturalearth.s3.amazonaws.com/{CARTOPY_RESOLUTION}_physical/"
    f"{CARTOPY_LAND_STEM}.zip"
)
CARTOPY_ARCHIVE_SHA256 = {
    "50m": "0b8e670cf80dce9cbebe2a193bc44ba5602758c22e1fa603980553646d7ff162",
}.get(CARTOPY_RESOLUTION)
if CARTOPY_ARCHIVE_SHA256 is None:
    raise ValueError(
        f"no pinned Natural Earth land checksum for resolution {CARTOPY_RESOLUTION!r}"
    )
