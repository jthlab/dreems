        prepared=temp(prepared_path("{split}", "{chunk}")),
        metadata=temp(prepared_meta_path("{split}", "{chunk}")),
    params:
        example_index=prepare_chunk_example_index,
    threads: int(config.get("prepare_threads", 4))
    resources:
        mem_mb=int(config.get("prepare_mem_mb", 32000)),
        runtime=slurm_time(config.get("prepare_runtime", "120m")),
        slurm_partition=str(config.get("prepare_partition", "standard")),
    shell:
        """
        export JAX_PLATFORMS=cpu
        export CUDA_VISIBLE_DEVICES=""
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export NUMEXPR_NUM_THREADS={threads}
        {UV_RUN} python -m dreems.pipeline prepare-shard \
            --config {input.config:q} \
            --input {input.raw:q} \
            --output {output.prepared:q} \
            --metadata {output.metadata:q} \
            --example-index {params.example_index}
        """


