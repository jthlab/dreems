    input:
        ALL_TARGETS


rule write_simulation_config:
    output:
        SIMULATION_CONFIG,
    run:
        path = Path(output[0])
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(SIMULATION_CONFIG_TEXT)


rule write_feature_config:
    output:
        FEATURE_CONFIG,
    run:
        path = Path(output[0])
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(FEATURE_CONFIG_TEXT)


rule write_training_config:
    output:
        TRAINING_CONFIG,
    run:
        path = Path(output[0])
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(TRAINING_CONFIG_TEXT)


rule cache_cartopy_land:
    output:
        archive=CARTOPY_ARCHIVE,
        shp=f"{CARTOPY_LAND_DIR}/{CARTOPY_LAND_STEM}.shp",
        shx=f"{CARTOPY_LAND_DIR}/{CARTOPY_LAND_STEM}.shx",
        dbf=f"{CARTOPY_LAND_DIR}/{CARTOPY_LAND_STEM}.dbf",
        prj=f"{CARTOPY_LAND_DIR}/{CARTOPY_LAND_STEM}.prj",
        cpg=f"{CARTOPY_LAND_DIR}/{CARTOPY_LAND_STEM}.cpg",
        ready=touch(CARTOPY_READY),
    params:
        url=CARTOPY_ARCHIVE_URL,
        checksum=CARTOPY_ARCHIVE_SHA256,
        archive_partial=f"{CARTOPY_ARCHIVE}.partial",
        land_dir=CARTOPY_LAND_DIR,
        land_glob=f"{CARTOPY_LAND_STEM}.*",
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.archive:q})" {params.land_dir:q}
        curl --fail --location --retry 3 \
            --silent --show-error \
            --output {params.archive_partial:q} \
            {params.url:q}
        test "$(sha256sum {params.archive_partial:q} | awk '{{print $1}}')" = \
            {params.checksum:q}
        mv {params.archive_partial:q} {output.archive:q}
        unzip -oq {output.archive:q} {params.land_glob:q} -d {params.land_dir:q}
        touch {output.ready:q}
        """


rule generate_raw_example:
    input:
        cartopy=CARTOPY_READY,
        config=SIMULATION_CONFIG,
        code=SIMULATION_SOURCES,
    output:
        raw=temp(raw_staging_path("{split}", "{chunk}")),
    threads: int(config.get("raw_threads", 4))
    resources:
        mem_mb=int(config.get("raw_mem_mb", 32000)),
        runtime=slurm_time(config.get("raw_runtime", "120m")),
        slurm_partition=str(config.get("raw_partition", "standard")),
    shell:
        """
        export JAX_PLATFORMS=cpu
        export CUDA_VISIBLE_DEVICES=""
        export CARTOPY_DATA_DIR={CARTOPY_DATA_DIR:q}
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export NUMEXPR_NUM_THREADS={threads}
        {UV_RUN} python -m dreems.corpus generate \
            --config {input.config:q} \
            --split {wildcards.split} \
            --example-id {wildcards.chunk} \
            --output {output.raw:q}
        """


rule pack_raw_examples:
    input:
        examples=raw_pack_staging_inputs,
        config=SIMULATION_CONFIG,
        code=SIMULATION_SOURCES,
    output:
        packed=raw_pack_path("{split}", "{pack}"),
        metadata=raw_pack_meta_path("{split}", "{pack}"),
    benchmark:
        f"{OUTDIR}/benchmarks/raw_pack/{{split}}/{{pack}}.tsv"
    wildcard_constraints:
        split="train|test",
        pack=r"\d+",
    priority: 50
    threads: int(config.get("raw_pack_threads", 1))
    resources:
        mem_mb=int(config.get("raw_pack_mem_mb", 8000)),
        runtime=slurm_time(config.get("raw_pack_runtime", "30m")),
        slurm_partition=str(config.get("raw_pack_partition", "standard")),
    params:
        start=lambda wildcards: int(wildcards.pack) * RAW_PACK_SIZE,
    shell:
        """
        export JAX_PLATFORMS=cpu
        export CUDA_VISIBLE_DEVICES=""
        {UV_RUN} python -m dreems.corpus pack \
            --inputs {input.examples:q} \
            --output {output.packed:q} \
            --metadata {output.metadata:q} \
            --config {input.config:q} \
            --split {wildcards.split} \
            --pack-index {wildcards.pack} \
            --start-index {params.start}
        """


rule prepare_chunk:
    input:
        raw=prepare_chunk_raw_input,
        config=FEATURE_CONFIG,
        code=PREPARATION_SOURCES,
    output:
        prepared=temp(prepared_path("{split}", "{chunk}")),
        metadata=temp(prepared_meta_path("{split}", "{chunk}")),
    params:
        example_index=prepare_chunk_example_index,
    threads: int(config.get("prepare_threads", 4))
    resources:
        mem_mb=int(config.get("prepare_mem_mb", 32000)),
        runtime=slurm_time(config.get("prepare_runtime", "120m")),
        slurm_partition=str(config.get("prepare_partition", "standard")),
    shell:
        """
        export JAX_PLATFORMS=cpu
        export CUDA_VISIBLE_DEVICES=""
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export NUMEXPR_NUM_THREADS={threads}
        {UV_RUN} python -m dreems.pipeline prepare-shard \
            --config {input.config:q} \
            --input {input.raw:q} \
            --output {output.prepared:q} \
            --metadata {output.metadata:q} \
            --example-index {params.example_index}
        """


rule pack_prepared:
    input:
        prepared=pack_prepared_inputs,
        config=TRAINING_CONFIG,
        code=PACKING_SOURCES,
    output:
        packed=legacy_packed_path("{role}", "{pack}"),
        metadata=legacy_packed_meta_path("{role}", "{pack}"),
    benchmark:
        f"{OUTDIR}/benchmarks/pack/{{role}}/{{pack}}.tsv"
    wildcard_constraints:
        role="train|validation",
        pack=r"\d+",
    threads: int(config.get("pack_threads", 1))
    resources:
        mem_mb=int(config.get("pack_mem_mb", 4000)),
        runtime=slurm_time(config.get("pack_runtime", "60m")),
        slurm_partition=str(config.get("pack_partition", "standard")),
    shell:
        """
        export JAX_PLATFORMS=cpu
        export CUDA_VISIBLE_DEVICES=""
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export NUMEXPR_NUM_THREADS={threads}
        {UV_RUN} python -m dreems.pipeline pack-prepared \
            --inputs {input.prepared:q} \
            --output {output.packed:q} \
            --metadata {output.metadata:q}
        """


rule prepare_batch:
    input:
        raw=prepare_batch_raw_inputs,
        config=FEATURE_CONFIG,
        code=PREPARATION_SOURCES,
    output:
        packed=prepared_batch_path("{role}", "{pack}"),
        metadata=prepared_batch_meta_path("{role}", "{pack}"),
    benchmark:
        f"{OUTDIR}/benchmarks/prepare_batch/{{role}}/{{pack}}.tsv"
    wildcard_constraints:
        role="train|validation",
        pack=r"\d+",
    params:
        start_index=prepare_batch_start_index,
        max_examples=prepare_batch_example_count,
    threads: int(config.get("prepare_batch_threads", 1))
    resources:
        mem_mb=int(config.get("prepare_batch_mem_mb", 4000)),
        runtime=slurm_time(config.get("prepare_batch_runtime", "120m")),
        slurm_partition=str(config.get("prepare_partition", "standard")),
    shell:
        """
        export JAX_PLATFORMS=cpu
        export CUDA_VISIBLE_DEVICES=""
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export NUMEXPR_NUM_THREADS={threads}
        {UV_RUN} python -m dreems.pipeline prepare-batch \
            --config {input.config:q} \
            --inputs {input.raw:q} \
            --output {output.packed:q} \
            --metadata {output.metadata:q} \
            --start-index {params.start_index} \
            --max-examples {params.max_examples}
        """


rule write_prepared_manifest:
    input:
        prepared_manifest_inputs,
    output:
        manifest=prepared_manifest_path("{split}"),
    run:
        from pathlib import Path

        split = str(wildcards.split)
        manifest_paths = [
            str(Path(prepared_path(split, chunk)).resolve())
            for chunk in split_chunks(split)
        ]
        path = Path(output.manifest)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(manifest_paths) + "\n")


rule production_tranche:
    input:
        production_tranche_inputs,
    output:
        done=tranche_done_path("{split}", "{tranche}"),
    run:
        from pathlib import Path

        path = Path(output.done)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(str(item) for item in input) + "\n")


