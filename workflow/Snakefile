    raise ValueError("train_accelerator must be 'cpu' or 'cuda'")
if TRAIN_ACCELERATOR == "cpu" and TRAIN_GPUS != 0:
    raise ValueError("CPU training requires train_gpus: 0")
if TRAIN_ACCELERATOR == "cuda" and TRAIN_GPUS <= 0:
    raise ValueError("CUDA training requires at least one GPU")
