)
EVALUATION_SOURCES = source_paths(
    "pipeline.py", "checkpoints.py", "features.py", "metrics.py", "model.py", "workflow_io.py"
)


def config_snapshot(name, payload):
    serialized = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    digest = hashlib.sha256(serialized.encode()).hexdigest()[:16]
    return f"{OUTDIR}/config/{name}.{digest}.json", serialized + "\n"


SIMULATION_CONFIG, SIMULATION_CONFIG_TEXT = config_snapshot(
    "simulation", {"simulation": config["simulation"]}
)
FEATURE_CONFIG, FEATURE_CONFIG_TEXT = config_snapshot(
    "features",
    {
        "dreems": {
            key: config["dreems"][key]
            for key in ("features", "edge_conditioner")
        }
    },
)
TRAINING_CONFIG, TRAINING_CONFIG_TEXT = config_snapshot(
    "training",
    {
        "dreems": config["dreems"],
        "base_validation_examples": config.get(
            "base_validation_examples", config["train_validation_examples"]
        ),
        "train_validation_examples": config["train_validation_examples"],
        "train_pack_size": config.get("train_pack_size", 64),
        "validation_pack_size": config.get(
            "validation_pack_size", config.get("train_pack_size", 64)
        ),
        "prepared_pack_source_dir": config.get("prepared_pack_source_dir"),
        "normalization_source": config.get("normalization_source"),
        "supplemental_prepared_packs": config.get("supplemental_prepared_packs", {}),
    },
)
TRAIN_EXAMPLES = int(config["train_examples"])
TEST_EXAMPLES = int(config["test_examples"])
if TRAIN_EXAMPLES <= 0 or TEST_EXAMPLES <= 0:
    raise ValueError("train_examples and test_examples must be positive")
TRAIN_PACK_SIZE = int(config.get("train_pack_size", 64))
VALIDATION_PACK_SIZE = int(config.get("validation_pack_size", TRAIN_PACK_SIZE))
PREPARE_BATCH_SIZE = int(config.get("prepare_batch_size", 1))
RAW_PACK_SIZE = int(config.get("raw_pack_size", TRAIN_PACK_SIZE))
VALIDATION_EXAMPLES = int(
    config.get("base_validation_examples", config["train_validation_examples"])
)
if (
    TRAIN_PACK_SIZE <= 0
    or VALIDATION_PACK_SIZE <= 0
    or PREPARE_BATCH_SIZE <= 0
    or RAW_PACK_SIZE <= 0
):
    raise ValueError("raw, training, validation, and preparation pack sizes must be positive")
USE_BATCHED_PREPARATION = PREPARE_BATCH_SIZE > 1
if USE_BATCHED_PREPARATION and (
    PREPARE_BATCH_SIZE != TRAIN_PACK_SIZE
    or PREPARE_BATCH_SIZE != VALIDATION_PACK_SIZE
):
    raise ValueError(
        "prepare_batch_size must equal both train_pack_size and "
        "validation_pack_size"
    )
if not 0 < VALIDATION_EXAMPLES <= TEST_EXAMPLES:
    raise ValueError("base validation examples must be in [1, test_examples]")


def project_path(value):
    path = Path(str(value)).expanduser()
    return str(path if path.is_absolute() else Path(PROJECT_ROOT, path).resolve())


def supplemental_pack_paths(role):
    specification = config.get("supplemental_prepared_packs", {}).get(role)
    if specification is None:
        return []
    if not isinstance(specification, dict):
        raise ValueError(f"supplemental_prepared_packs.{role} must be a mapping")
    pattern = project_path(specification["pattern"])
    start = int(specification.get("start", 0))
    count = int(specification["count"])
    if start < 0 or count < 0:
        raise ValueError("supplemental prepared pack start and count must be nonnegative")
    return [pattern.format(pack=pack) for pack in range(start, start + count)]


RAW_SOURCE_DIR = (
    project_path(config["raw_source_dir"]) if config.get("raw_source_dir") else None
)
RAW_SOURCE_LAYOUT = str(
    config.get("raw_source_layout") or ("examples" if RAW_SOURCE_DIR else "packs")
)
if RAW_SOURCE_LAYOUT not in {"examples", "packs"}:
    raise ValueError("raw_source_layout must be 'examples' or 'packs'")
if RAW_SOURCE_DIR is None and RAW_SOURCE_LAYOUT != "packs":
    raise ValueError("new corpus generation requires packed raw storage")
PREPARED_PACK_SOURCE_DIR = (
    project_path(config["prepared_pack_source_dir"])
    if config.get("prepared_pack_source_dir")
    else None
)
NORMALIZATION_SOURCE = (
    project_path(config["normalization_source"])
    if config.get("normalization_source")
    else None
)
SUPPLEMENTAL_PACKS = {
    role: supplemental_pack_paths(role) for role in ("train", "validation")
}
PUBLISH_DIR = project_path(config["publish_dir"]) if config.get("publish_dir") else None


CARTOPY_DATA_DIR = project_path(config["simulation"]["global_landscape_cartopy_data_dir"])
CARTOPY_RESOLUTION = str(config["simulation"]["global_landscape_resolution"])
CARTOPY_READY = f"{CARTOPY_DATA_DIR}/.natural_earth_{CARTOPY_RESOLUTION}_land.ready"
CARTOPY_LAND_STEM = f"ne_{CARTOPY_RESOLUTION}_land"
CARTOPY_LAND_DIR = f"{CARTOPY_DATA_DIR}/shapefiles/natural_earth/physical"
CARTOPY_ARCHIVE = f"{CARTOPY_DATA_DIR}/downloads/{CARTOPY_LAND_STEM}.zip"
CARTOPY_ARCHIVE_URL = (
    f"https://naturalearth.s3.amazonaws.com/{CARTOPY_RESOLUTION}_physical/"
    f"{CARTOPY_LAND_STEM}.zip"
)
CARTOPY_ARCHIVE_SHA256 = {
    "50m": "0b8e670cf80dce9cbebe2a193bc44ba5602758c22e1fa603980553646d7ff162",
}.get(CARTOPY_RESOLUTION)
if CARTOPY_ARCHIVE_SHA256 is None:
    raise ValueError(
        f"no pinned Natural Earth land checksum for resolution {CARTOPY_RESOLUTION!r}"
    )
TRAIN_ACCELERATOR = str(config.get("train_accelerator", "cuda")).lower()
TRAIN_GPUS = int(config.get("train_gpus", 1))
if TRAIN_ACCELERATOR not in {"cpu", "cuda"}:
    raise ValueError("train_accelerator must be 'cpu' or 'cuda'")
if TRAIN_ACCELERATOR == "cpu" and TRAIN_GPUS != 0:
    raise ValueError("CPU training requires train_gpus: 0")
if TRAIN_ACCELERATOR == "cuda" and TRAIN_GPUS <= 0:
    raise ValueError("CUDA training requires at least one GPU")
TRAIN_DEVICE_ENV = (
    'export JAX_PLATFORMS=cpu; export CUDA_VISIBLE_DEVICES=""'
    if TRAIN_ACCELERATOR == "cpu"
    else "export JAX_PLATFORMS=cuda"
)
TRAIN_JAX_PLATFORM = "cpu" if TRAIN_ACCELERATOR == "cpu" else "gpu"
TRAIN_GRES = f"gpu:{TRAIN_GPUS}" if TRAIN_GPUS else ""

localrules: all, cache_cartopy_land, write_simulation_config, write_feature_config, write_training_config, production_tranche, write_prepared_manifest, write_normalization_manifest, write_training_input_manifest, aggregate_evaluations


def slurm_time(value):
    if isinstance(value, int):
        return f"{value}m"
    return str(value)


TRAIN_CHUNKS = list(range(TRAIN_EXAMPLES))
TEST_CHUNKS = list(range(TEST_EXAMPLES))
PRODUCTION_TRANCHE_SIZE = int(config.get("production_tranche_size", 0) or 0)
USE_TRANCHE_AGGREGATION = PRODUCTION_TRANCHE_SIZE > 0
NORMALIZATION_GROUP_SIZE = int(config.get("normalization_group_size", 1))
if NORMALIZATION_GROUP_SIZE <= 0:
    raise ValueError("normalization_group_size must be positive")
NORMALIZATION_GROUPS = list(
    range(math.ceil(len(TRAIN_CHUNKS) / NORMALIZATION_GROUP_SIZE))
)


def split_chunks(split):
    if split == "train":
        return TRAIN_CHUNKS
    if split == "test":
        return TEST_CHUNKS
    raise ValueError(f"unknown split: {split}")


def split_tranches(split):
    if not USE_TRANCHE_AGGREGATION:
        return []
    chunks = split_chunks(split)
    return list(range(math.ceil(len(chunks) / PRODUCTION_TRANCHE_SIZE)))


def tranche_chunks(split, tranche):
    chunks = split_chunks(split)
    if not USE_TRANCHE_AGGREGATION:
        return chunks
    start = int(tranche) * PRODUCTION_TRANCHE_SIZE
    stop = min(start + PRODUCTION_TRANCHE_SIZE, len(chunks))
    return chunks[start:stop]


def raw_staging_path(split, chunk):
    return f"{OUTDIR}/staging/raw/{split}/chunk_{chunk}.pkl"


def raw_pack_path(split, pack):
    return f"{OUTDIR}/raw/{split}/pack_{pack}.pkl"


def raw_pack_meta_path(split, pack):
    return f"{OUTDIR}/raw/{split}/pack_{pack}.metadata.json"


def raw_pack_indices(split):
    return list(range(math.ceil(len(split_chunks(split)) / RAW_PACK_SIZE)))


def raw_pack_chunks(split, pack):
    chunks = split_chunks(split)
    start = int(pack) * RAW_PACK_SIZE
    return chunks[start : min(start + RAW_PACK_SIZE, len(chunks))]


def raw_pack_staging_inputs(wildcards):
    split = str(wildcards.split)
    return [
        raw_staging_path(split, chunk)
        for chunk in raw_pack_chunks(split, int(wildcards.pack))
    ]


def raw_pack_input_path(split, pack):
    """Return a generated pack or an existing packed-corpus input."""

    if RAW_SOURCE_DIR is not None:
        return f"{RAW_SOURCE_DIR}/{split}/pack_{pack}.pkl"
    return raw_pack_path(split, pack)


def raw_input_path(split, chunk):
    """Locate one example directly or locate the pack that contains it."""

    if RAW_SOURCE_LAYOUT == "examples":
        assert RAW_SOURCE_DIR is not None
        return f"{RAW_SOURCE_DIR}/{split}/chunk_{chunk}.pkl"
    return raw_pack_input_path(split, int(chunk) // RAW_PACK_SIZE)


def raw_example_index(chunk):
    if RAW_SOURCE_LAYOUT == "examples":
        return 0
    return int(chunk) % RAW_PACK_SIZE


def prepared_path(split, chunk):
    return f"{OUTDIR}/prepared/{split}/chunk_{chunk}.pkl"


def prepared_meta_path(split, chunk):
    return f"{OUTDIR}/prepared/{split}/chunk_{chunk}.metadata.json"


def legacy_packed_path(role, pack):
    return f"{OUTDIR}/packed/{role}/pack_{pack}.pkl"


def legacy_packed_meta_path(role, pack):
    return f"{OUTDIR}/packed/{role}/pack_{pack}.metadata.json"


def prepared_batch_path(role, pack):
    return f"{OUTDIR}/prepared_batches/{role}/pack_{pack}.pkl"


def prepared_batch_meta_path(role, pack):
    return f"{OUTDIR}/prepared_batches/{role}/pack_{pack}.metadata.json"


def packed_path(role, pack):
    if USE_BATCHED_PREPARATION:
        return prepared_batch_path(role, pack)
    return legacy_packed_path(role, pack)


def pack_size(role):
    if role == "train":
        return TRAIN_PACK_SIZE
    if role == "validation":
        return VALIDATION_PACK_SIZE
    raise ValueError(f"unknown pack role: {role}")


def pack_example_count(role):
    if role == "train":
        return TRAIN_EXAMPLES
    if role == "validation":
        return VALIDATION_EXAMPLES
    raise ValueError(f"unknown pack role: {role}")


def pack_indices(role):
    return list(range(math.ceil(pack_example_count(role) / pack_size(role))))


def packed_paths(role):
    return [training_pack_path(role, pack) for pack in pack_indices(role)]


def training_pack_path(role, pack):
    if PREPARED_PACK_SOURCE_DIR is not None:
        return f"{PREPARED_PACK_SOURCE_DIR}/{role}/pack_{pack}.pkl"
    return packed_path(role, pack)


def pack_prepared_inputs(wildcards):
    role = str(wildcards.role)
    pack = int(wildcards.pack)
    start = pack * pack_size(role)
    stop = min(start + pack_size(role), pack_example_count(role))
    split = "train" if role == "train" else "test"
    return [prepared_path(split, chunk) for chunk in range(start, stop)]


def prepare_batch_raw_inputs(wildcards):
    role = str(wildcards.role)
    pack = int(wildcards.pack)
    start = pack * pack_size(role)
    stop = min(start + pack_size(role), pack_example_count(role))
    split = "train" if role == "train" else "test"
    if RAW_SOURCE_LAYOUT == "examples":
        return [raw_input_path(split, chunk) for chunk in range(start, stop)]
    first_pack = start // RAW_PACK_SIZE
    final_pack = (stop - 1) // RAW_PACK_SIZE
    return [raw_pack_input_path(split, index) for index in range(first_pack, final_pack + 1)]


def prepare_batch_start_index(wildcards):
    if RAW_SOURCE_LAYOUT == "examples":
        return 0
    role = str(wildcards.role)
    start = int(wildcards.pack) * pack_size(role)
    return start % RAW_PACK_SIZE


def prepare_batch_example_count(wildcards):
    role = str(wildcards.role)
    start = int(wildcards.pack) * pack_size(role)
    stop = min(start + pack_size(role), pack_example_count(role))
    return stop - start


def normalization_group_path(group):
    return f"{OUTDIR}/normalization/group_{group}.stats.json"


def normalization_group_inputs(wildcards):
    group = int(wildcards.group)
    start = group * NORMALIZATION_GROUP_SIZE
    stop = min(start + NORMALIZATION_GROUP_SIZE, TRAIN_EXAMPLES)
    if USE_BATCHED_PREPARATION:
        if start % TRAIN_PACK_SIZE != 0 or stop % TRAIN_PACK_SIZE != 0:
            raise ValueError(
                "normalization_group_size must align with train_pack_size "
                "when preparation is batched"
            )
        return [
            training_pack_path("train", pack)
            for pack in range(start // TRAIN_PACK_SIZE, stop // TRAIN_PACK_SIZE)
        ]
    return [prepared_path("train", chunk) for chunk in range(start, stop)]


def prepared_manifest_path(split):
    return f"{OUTDIR}/manifests/{split}_prepared.txt"


def eval_prepared_input_path(wildcards):
    return prepared_path("test", int(wildcards.chunk))


def prepare_chunk_raw_input(wildcards):
    return raw_input_path(str(wildcards.split), int(wildcards.chunk))


def prepare_chunk_example_index(wildcards):
    return raw_example_index(int(wildcards.chunk))


def normalization_manifest_path():
    return f"{OUTDIR}/manifests/train_normalization_stats.txt"


def training_normalization_path():
    if NORMALIZATION_SOURCE is not None:
        return NORMALIZATION_SOURCE
    return f"{OUTDIR}/normalization.json"


def training_input_manifest_path(role):
    return f"{OUTDIR}/manifests/{role}_packs.txt"


def training_accelerator_ready_path():
    return f"{OUTDIR}/environment/{TRAIN_ACCELERATOR}.ready"


def training_manifest_inputs(wildcards):
    role = str(wildcards.role)
    return [*packed_paths(role), *SUPPLEMENTAL_PACKS[role]]


def eval_chunk_summary_path(chunk):
    return f"{OUTDIR}/eval/chunks/chunk_{chunk}/summary.json"


def eval_chunk_csv_path(chunk):
    return f"{OUTDIR}/eval/chunks/chunk_{chunk}/summary.csv"


def tranche_done_path(split, tranche):
    return f"{OUTDIR}/tranches/{split}_{tranche}.done"


def prepared_manifest_inputs(wildcards):
    split = str(wildcards.split)
    if USE_TRANCHE_AGGREGATION:
        return expand(tranche_done_path(split, "{tranche}"), tranche=split_tranches(split))
    return [prepared_path(split, chunk) for chunk in split_chunks(split)]


def normalization_manifest_inputs(_wildcards=None):
    return expand(normalization_group_path("{group}"), group=NORMALIZATION_GROUPS)


def production_tranche_inputs(wildcards):
    split = str(wildcards.split)
    chunks = tranche_chunks(split, int(wildcards.tranche))
    return [prepared_path(split, chunk) for chunk in chunks]


ALL_TARGETS = [
    f"{OUTDIR}/model/training_summary.json",
    f"{OUTDIR}/eval/summary.json",
]
if PUBLISH_DIR is not None:
    ALL_TARGETS.extend(
