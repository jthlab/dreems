)
if RAW_SOURCE_LAYOUT not in {"examples", "packs"}:
    raise ValueError("raw_source_layout must be 'examples' or 'packs'")
if RAW_SOURCE_DIR is None and RAW_SOURCE_LAYOUT != "packs":
    raise ValueError("new corpus generation requires packed raw storage")
