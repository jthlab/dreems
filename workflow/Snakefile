    role: surface_gate_pack_paths(role) for role in ("train", "validation")
}
if USE_STAGED_SURFACE_GATE and any(
    not SURFACE_GATE_PACKS[role] for role in ("train", "validation")
):
    raise ValueError("staged surface-gate training requires train and validation packs")
