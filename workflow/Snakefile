            f"{PUBLISH_DIR}/checkpoint.best.dreems.zip",
            f"{PUBLISH_DIR}/checkpoint.best.summary.json",
            f"{PUBLISH_DIR}/training_summary.json",
            f"{PUBLISH_DIR}/training_history.jsonl",
        ]
    )


