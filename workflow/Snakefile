rule check_training_accelerator:
    input:
        pyproject=str(Path(PROJECT_ROOT, "pyproject.toml")),
        lock=str(Path(PROJECT_ROOT, "uv.lock")),
    output:
        ready=touch(training_accelerator_ready_path()),
    params:
        device_env=TRAIN_DEVICE_ENV,
        expected_platform=TRAIN_JAX_PLATFORM,
    threads: 1
    resources:
        mem_mb=int(config.get("accelerator_check_mem_mb", 4000)),
        runtime=slurm_time(config.get("accelerator_check_runtime", "10m")),
        gres=TRAIN_GRES,
        slurm_partition=str(config.get("train_partition", "gpu_mig40,spgpu,gpu")),
    shell:
        """
        {params.device_env}
        {UV_RUN} python -c 'import jax; devices = jax.devices(); assert devices and all(device.platform == "{params.expected_platform}" for device in devices), devices; print("JAX devices:", devices, flush=True)'
        """


# The same command trains a complete model or one head on a frozen core.
# Keep the existing rule names and output paths for saved Snakemake runs.
TRAIN_MODEL_DIR = f"{OUTDIR}/model/core" if USE_STAGED_SURFACE_GATE else f"{OUTDIR}/model"
TRAIN_RULE_NAME = "train_core" if USE_STAGED_SURFACE_GATE else "train"


rule train:
    name: TRAIN_RULE_NAME
    input:
        normalization=training_normalization_path(),
        train_manifest=training_input_manifest_path("train"),
        validation_manifest=training_input_manifest_path("validation"),
        accelerator=training_accelerator_ready_path(),
        config=TRAINING_CONFIG,
        init=[],
        code=TRAINING_SOURCES,
    output:
        checkpoint=f"{TRAIN_MODEL_DIR}/checkpoint.dreems.zip",
        best=f"{TRAIN_MODEL_DIR}/checkpoint.best.dreems.zip",
        best_summary=f"{TRAIN_MODEL_DIR}/checkpoint.best.summary.json",
        summary=f"{TRAIN_MODEL_DIR}/training_summary.json",
        history=f"{TRAIN_MODEL_DIR}/training_history.jsonl",
    benchmark:
        f"{OUTDIR}/benchmarks/{TRAIN_RULE_NAME}.tsv"
    params:
        device_env=TRAIN_DEVICE_ENV,
        expected_platform=TRAIN_JAX_PLATFORM,
    threads: int(config.get("train_threads", 4))
    resources:
        mem_mb=int(config.get("train_mem_mb", 24000)),
        runtime=slurm_time(config.get("train_runtime", "90m")),
        gres=TRAIN_GRES,
        slurm_partition=str(config.get("train_partition", "gpu_mig40,spgpu,gpu")),
    shell:
        """
        {params.device_env}
        export XLA_PYTHON_CLIENT_MEM_FRACTION={config[xla_mem_fraction]}
        {UV_RUN} python -c 'import jax; devices = jax.devices(); assert devices and all(device.platform == "{params.expected_platform}" for device in devices), devices; print("JAX devices:", devices, flush=True)'
        CACHE_ROOT="$(mktemp -d "${{TMPDIR:-/tmp}}/dreems-train.XXXXXX")"
        trap 'rm -rf "$CACHE_ROOT"' EXIT
        init=({input.init:q})
        init_args=()
        if (( ${{#init[@]}} )); then
            init_args=(--init-checkpoint "${{init[0]}}")
        fi
        {UV_RUN} python -m dreems.pipeline train \
            --config {input.config:q} \
            --normalization {input.normalization:q} \
            --input-manifest {input.train_manifest:q} \
            --validation-input-manifest {input.validation_manifest:q} \
            "${{init_args[@]}}" \
            --cache-dir "$CACHE_ROOT/data" \
            --output {output.checkpoint:q} \
            --summary {output.summary:q} \
            --stream
        """


if USE_STAGED_SURFACE_GATE:

    use rule train_core as train_surface_gate with:
        input:
            normalization=training_normalization_path(),
            train_manifest=surface_gate_input_manifest_path("train"),
            validation_manifest=surface_gate_input_manifest_path("validation"),
            accelerator=training_accelerator_ready_path(),
            config=SURFACE_GATE_TRAINING_CONFIG,
            init=f"{OUTDIR}/model/core/checkpoint.best.dreems.zip",
            code=TRAINING_SOURCES,
        output:
            checkpoint=f"{OUTDIR}/model/checkpoint.dreems.zip",
            best=f"{OUTDIR}/model/checkpoint.best.dreems.zip",
            best_summary=f"{OUTDIR}/model/checkpoint.best.summary.json",
            summary=f"{OUTDIR}/model/training_summary.json",
            history=f"{OUTDIR}/model/training_history.jsonl",
        benchmark:
            f"{OUTDIR}/benchmarks/train_surface_gate.tsv"
        threads: int(SURFACE_GATE_STAGE.get("threads", config.get("train_threads", 4)))
        resources:
            mem_mb=int(
                SURFACE_GATE_STAGE.get("mem_mb", config.get("train_mem_mb", 24000))
            ),
            runtime=slurm_time(
                SURFACE_GATE_STAGE.get("runtime", config.get("train_runtime", "90m"))
            ),
            gres=TRAIN_GRES,
            slurm_partition=str(
                SURFACE_GATE_STAGE.get(
                    "partition", config.get("train_partition", "gpu_mig40,spgpu,gpu")
                )
            ),


if PUBLISH_DIR is not None:

    rule publish_training:
        input:
            checkpoint=f"{OUTDIR}/model/checkpoint.best.dreems.zip",
            best_summary=f"{OUTDIR}/model/checkpoint.best.summary.json",
            summary=f"{OUTDIR}/model/training_summary.json",
            history=f"{OUTDIR}/model/training_history.jsonl",
        output:
            checkpoint=f"{PUBLISH_DIR}/checkpoint.best.dreems.zip",
            best_summary=f"{PUBLISH_DIR}/checkpoint.best.summary.json",
            summary=f"{PUBLISH_DIR}/training_summary.json",
            history=f"{PUBLISH_DIR}/training_history.jsonl",
        params:
            directory=str(PUBLISH_DIR),
        shell:
            """
            mkdir -p {params.directory:q}
            sources=({input:q})
            destinations=({output:q})
            for index in "${{!sources[@]}}"; do
                destination="${{destinations[$index]}}"
                cp "${{sources[$index]}}" "$destination.tmp"
                mv "$destination.tmp" "$destination"
            done
            """


if PUBLISH_DIR is not None and USE_STAGED_SURFACE_GATE:

    use rule publish_training as publish_core_training with:
        input:
            checkpoint=f"{OUTDIR}/model/core/checkpoint.best.dreems.zip",
            best_summary=f"{OUTDIR}/model/core/checkpoint.best.summary.json",
            summary=f"{OUTDIR}/model/core/training_summary.json",
            history=f"{OUTDIR}/model/core/training_history.jsonl",
        output:
            checkpoint=f"{PUBLISH_DIR}/core/checkpoint.best.dreems.zip",
            best_summary=f"{PUBLISH_DIR}/core/checkpoint.best.summary.json",
            summary=f"{PUBLISH_DIR}/core/training_summary.json",
            history=f"{PUBLISH_DIR}/core/training_history.jsonl",
        params:
            directory=f"{PUBLISH_DIR}/core",


rule evaluate_chunk:
    input:
        checkpoint=f"{OUTDIR}/model/checkpoint.best.dreems.zip",
        prepared=eval_prepared_input_path,
        code=EVALUATION_SOURCES,
    output:
        summary=temp(eval_chunk_summary_path("{chunk}")),
        csv=temp(eval_chunk_csv_path("{chunk}")),
    params:
        outdir=f"{OUTDIR}/eval/chunks/chunk_{{chunk}}",
    threads: int(config.get("eval_threads", 4))
    resources:
        mem_mb=int(config.get("eval_mem_mb", 24000)),
        runtime=slurm_time(config.get("eval_runtime", "60m")),
        slurm_partition=str(config.get("eval_partition", "standard")),
    shell:
        """
        export JAX_LOGGING_LEVEL=CRITICAL
        export JAX_PLATFORMS=cpu
        export JAX_PLATFORM_NAME=cpu
        export CUDA_VISIBLE_DEVICES=""
        export XLA_PYTHON_CLIENT_PREALLOCATE=false
        export XLA_PYTHON_CLIENT_MEM_FRACTION=0.10
        export OMP_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        {UV_RUN} python -m dreems.pipeline evaluate \
            --checkpoint {input.checkpoint:q} \
            --inputs {input.prepared:q} \
            --output-dir {params.outdir:q} \
            --batch-size {config[eval_batch_size]} \
            --replicate-offset {wildcards.chunk}
        """


