    wildcard_constraints:
        role="train|validation",
    run:
        from pathlib import Path

        path = Path(output.manifest)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(str(Path(item).resolve()) for item in input) + "\n")


