    f"{UV_CACHE_PREFIX}uv --project {shlex.quote(PROJECT_ROOT)} run {UV_RUN_ARGS}"
)


def source_paths(*names):
    return [str(Path(PROJECT_ROOT, "src", "dreems", name).resolve()) for name in names]


SIMULATION_SOURCES = source_paths(
    "coalescent.py",
    "corpus.py",
    "geography.py",
    "island_sim.py",
    "motifs.py",
    "simulation.py",
    "simulation_config.py",
    "workflow_io.py",
) + [
    str(Path(PROJECT_ROOT, "rust", "island_sim", name).resolve())
    for name in ("Cargo.toml", "Cargo.lock", "src/lib.rs")
]
PREPARATION_SOURCES = source_paths(
    "pipeline.py", "corpus.py", "features.py", "linearized.py", "train.py", "workflow_io.py"
)
NORMALIZATION_SOURCES = source_paths("pipeline.py", "workflow_io.py")
PACKING_SOURCES = source_paths("pipeline.py", "workflow_io.py")
