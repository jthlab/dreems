def config_snapshot(name, payload):
    serialized = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    digest = hashlib.sha256(serialized.encode()).hexdigest()[:16]
    return f"{OUTDIR}/config/{name}.{digest}.json", serialized + "\n"


# Resolve only the seed in the worker snapshot. Adding every default here would
# change the config hash (and invalidate raw packs) for existing explicit seeds.
simulation_payload = dict(config["simulation"])
simulation_payload["seed"] = simulation_config.simulation_config(config)["seed"]
SIMULATION_CONFIG, SIMULATION_CONFIG_TEXT = config_snapshot(
    "simulation", {"simulation": simulation_payload}
)
FEATURE_CONFIG, FEATURE_CONFIG_TEXT = config_snapshot(
    "features",
    {
        "dreems": {
            key: config["dreems"][key]
            for key in ("features", "edge_conditioner")
        }
    },
)


def training_config_payload(dreems_config, validation_examples, **provenance):
    return {
        "dreems": dreems_config,
        "base_validation_examples": config.get(
            "base_validation_examples", config["train_validation_examples"]
        ),
        "train_validation_examples": validation_examples,
        "train_pack_size": config.get("train_pack_size", 64),
        "validation_pack_size": config.get(
            "validation_pack_size", config.get("train_pack_size", 64)
        ),
        "prepared_pack_source_dir": config.get("prepared_pack_source_dir"),
        "normalization_source": config.get("normalization_source"),
        "supplemental_prepared_packs": config.get("supplemental_prepared_packs", {}),
        **provenance,
    }


SURFACE_GATE_STAGE = config.get("surface_gate_stage", {})
if not isinstance(SURFACE_GATE_STAGE, dict):
    raise ValueError("surface_gate_stage must be a mapping")
USE_STAGED_SURFACE_GATE = bool(SURFACE_GATE_STAGE.get("enabled", False))

core_dreems_config = deepcopy(config["dreems"])
if USE_STAGED_SURFACE_GATE:
    if not bool(core_dreems_config.get("architecture", {}).get("surface_gate", False)):
        raise ValueError("staged surface-gate training requires architecture.surface_gate=true")
    if float(core_dreems_config.get("loss", {}).get("surface_gate_weight", 0.0)) <= 0.0:
        raise ValueError("staged surface-gate training requires a positive surface_gate_weight")
    core_dreems_config["architecture"]["surface_gate"] = False
    core_dreems_config["loss"]["surface_gate_weight"] = 0.0
    core_dreems_config["optimizer"]["trainable_scope"] = "all"

TRAINING_CONFIG, TRAINING_CONFIG_TEXT = config_snapshot(
    "training",
    training_config_payload(
        core_dreems_config,
        config["train_validation_examples"],
        training_stage="core" if USE_STAGED_SURFACE_GATE else "joint",
    ),
)

surface_gate_dreems_config = deepcopy(config["dreems"])
surface_gate_optimizer = SURFACE_GATE_STAGE.get("optimizer", {})
if not isinstance(surface_gate_optimizer, dict):
    raise ValueError("surface_gate_stage.optimizer must be a mapping")
surface_gate_dreems_config["optimizer"].update(surface_gate_optimizer)
if USE_STAGED_SURFACE_GATE:
    surface_gate_dreems_config["optimizer"]["trainable_scope"] = "surface_gate"
SURFACE_GATE_VALIDATION_EXAMPLES = int(
    SURFACE_GATE_STAGE.get("validation_examples", config["train_validation_examples"])
)
if SURFACE_GATE_VALIDATION_EXAMPLES <= 0:
    raise ValueError("surface_gate_stage.validation_examples must be positive")
SURFACE_GATE_TRAINING_CONFIG, SURFACE_GATE_TRAINING_CONFIG_TEXT = config_snapshot(
    "surface_gate_training",
    training_config_payload(
        surface_gate_dreems_config,
        SURFACE_GATE_VALIDATION_EXAMPLES,
        surface_gate_prepared_packs=SURFACE_GATE_STAGE.get("prepared_packs", {}),
        training_stage="surface_gate",
    ),
)
TRAIN_EXAMPLES = int(config["train_examples"])
TEST_EXAMPLES = int(config["test_examples"])
if TRAIN_EXAMPLES <= 0 or TEST_EXAMPLES <= 0:
    raise ValueError("train_examples and test_examples must be positive")
TRAIN_PACK_SIZE = int(config.get("train_pack_size", 64))
VALIDATION_PACK_SIZE = int(config.get("validation_pack_size", TRAIN_PACK_SIZE))
PREPARE_BATCH_SIZE = int(config.get("prepare_batch_size", 1))
RAW_PACK_SIZE = int(config.get("raw_pack_size", TRAIN_PACK_SIZE))
VALIDATION_EXAMPLES = int(
    config.get("base_validation_examples", config["train_validation_examples"])
)
if (
    TRAIN_PACK_SIZE <= 0
    or VALIDATION_PACK_SIZE <= 0
    or PREPARE_BATCH_SIZE <= 0
    or RAW_PACK_SIZE <= 0
):
    raise ValueError("raw, training, validation, and preparation pack sizes must be positive")
USE_BATCHED_PREPARATION = PREPARE_BATCH_SIZE > 1
if USE_BATCHED_PREPARATION and (
    PREPARE_BATCH_SIZE != TRAIN_PACK_SIZE
    or PREPARE_BATCH_SIZE != VALIDATION_PACK_SIZE
):
    raise ValueError(
        "prepare_batch_size must equal both train_pack_size and "
        "validation_pack_size"
    )
if not 0 < VALIDATION_EXAMPLES <= TEST_EXAMPLES:
    raise ValueError("base validation examples must be in [1, test_examples]")


def project_path(value):
    path = Path(str(value)).expanduser()
    return str(path if path.is_absolute() else Path(PROJECT_ROOT, path).resolve())


def configured_pack_paths(specification, label):
    if specification is None:
        return []
    specifications = specification if isinstance(specification, list) else [specification]
    paths = []
    for item in specifications:
        if not isinstance(item, dict):
            raise ValueError(f"{label} entries must be mappings")
        pattern = project_path(item["pattern"])
        start = int(item.get("start", 0))
        count = int(item["count"])
        if start < 0 or count < 0:
            raise ValueError(f"{label} start and count must be nonnegative")
        paths.extend(pattern.format(pack=pack) for pack in range(start, start + count))
    return paths


def supplemental_pack_paths(role):
    specification = config.get("supplemental_prepared_packs", {}).get(role)
    return configured_pack_paths(specification, f"supplemental_prepared_packs.{role}")


def surface_gate_pack_paths(role):
    prepared_packs = SURFACE_GATE_STAGE.get("prepared_packs", {})
    if not isinstance(prepared_packs, dict):
        raise ValueError("surface_gate_stage.prepared_packs must be a mapping")
    return configured_pack_paths(
        prepared_packs.get(role),
        f"surface_gate_stage.prepared_packs.{role}",
    )


RAW_SOURCE_DIR = (
    project_path(config["raw_source_dir"]) if config.get("raw_source_dir") else None
)
